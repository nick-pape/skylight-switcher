<?xml version="1.0" encoding="utf-8"?>
<!--
  Swipe in from the left or right screen edge to switch between the Skylight app (the
  home screen) and the Home Assistant app. The Skylight has no nav bar, recents or
  gesture navigation, so this draws its own invisible edge strips.

  targetSdkVersion 28 keeps starting a foreground service at boot simple. Two permissions
  are granted once over adb (see build.sh): SYSTEM_ALERT_WINDOW for the strips (it also
  lets the service start activities from the background) and GET_USAGE_STATS to see
  which app is in front.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="house.pape.switcher"
    android:versionCode="1"
    android:versionName="0.1">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="28" />

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="Skylight Switcher"
        android:icon="@android:drawable/ic_menu_rotate"
        android:allowBackup="false">

        <activity android:name=".MainActivity" android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service android:name=".EdgeService" android:exported="false" />

        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
